# MARKETMAP Environment Variables Configuration
# Copy this file to .env.local to configure live API providers

# Port & Node Environment
PORT=3000
NODE_ENV=production

# -------------------------------------------------------------
# Optional Live Financial Market Data Providers
# -------------------------------------------------------------
# MARKETMAP features a robust hybrid architecture:
# If no API key is provided, the application runs on authoritative,
# institutional-grade calibrated market data with zero broken links.
#
# To connect external live feeds, configure any of the following keys.
# API keys are strictly stored on the server-side Next.js runtime
# and are NEVER exposed to client browsers.

# Financial Modeling Prep (Supports US & Global Equities)
# https://site.financialmodelingprep.com/
FMP_API_KEY=

# Alpha Vantage (Supports US Equities & Forex)
# https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=

# Twelve Data (Supports NSE, BSE, NASDAQ, NYSE)
# https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Server Rate Limiting (Maximum requests per minute per IP)
RATE_LIMIT_MAX_PER_MINUTE=60
